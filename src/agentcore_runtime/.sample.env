# The public samples need no .env.
# For the S3 sample, copy this to .env beside the AgentCore Runtime README.
# The bucket, VPC, subnets, and security groups must already exist in the target region/account.
# Do not add AWS credentials. Use the normal AWS credential chain.
S3_BUCKET_NAME=REPLACE_WITH_EXISTING_BUCKET_NAME
# The filesystem uses the bucket root. Access points select profile directories.
VPC_SUBNET_IDS=REPLACE_WITH_PRIVATE_SUBNET_ID_1,REPLACE_WITH_PRIVATE_SUBNET_ID_2
VPC_SECURITY_GROUP_IDS=REPLACE_WITH_SECURITY_GROUP_ID
# Each profile mounts its dedicated access-point root directly at /mnt/workspace.
