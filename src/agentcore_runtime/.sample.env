# The public samples need no .env.
# For the S3 sample, copy this to .env beside the AgentCore Runtime README and fill each binding.
# Do not add AWS credentials. Use the normal AWS credential chain.
SHARED_VPC_SUBNET_IDS=REPLACE_WITH_SUBNET_ID_1,REPLACE_WITH_SUBNET_ID_2
SHARED_VPC_SECURITY_GROUP_IDS=REPLACE_WITH_SECURITY_GROUP_ID
SHARED_S3_FILES_ACCESS_POINT_ARN=REPLACE_WITH_S3_FILES_ACCESS_POINT_ARN
