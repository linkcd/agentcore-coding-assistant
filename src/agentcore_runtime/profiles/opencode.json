{
  "stackName": "HerdrOpenCodeRuntime",
  "runtimeName": "opencode_agentcore_runtime",
  "image": {
    "directory": ".",
    "file": "common/Dockerfile",
    "buildArgs": {
      "ASSISTANT_DIR": "opencode/image",
      "NPM_PACKAGE": "opencode-ai",
      "NPM_VERSION": "1.18.30",
      "EXECUTABLE": "opencode"
    }
  },
  "command": ["/app/run.sh"],
  "agentKind": "opencode",
  "inference": {
    "api": "bedrock",
    "modelId": "anthropic.claude-sonnet-4-5-20250929-v1:0"
  },
  "environment": {
    "AWS_REGION": "$RUNTIME_REGION",
    "AWS_PROFILE": "default",
    "BEDROCK_MODEL_ID": "$MODEL_ID"
  }
}
