{
  "stackName": "HerdrCodexRuntime",
  "runtimeName": "codex_agentcore_runtime",
  "image": {
    "directory": ".",
    "file": "common/Dockerfile",
    "buildArgs": {
      "ASSISTANT_DIR": "codex/image",
      "NPM_PACKAGE": "@openai/codex",
      "NPM_VERSION": "0.163.0",
      "EXECUTABLE": "codex"
    }
  },
  "command": ["/app/run.sh"],
  "agentKind": "codex",
  "inference": {
    "api": "mantle",
    "modelId": "openai.gpt-5.5",
    "region": "us-east-2"
  },
  "environment": {
    "AWS_REGION": "$RUNTIME_REGION",
    "BEDROCK_INFERENCE_REGION": "$INFERENCE_REGION",
    "BEDROCK_MODEL_ID": "$MODEL_ID"
  }
}
