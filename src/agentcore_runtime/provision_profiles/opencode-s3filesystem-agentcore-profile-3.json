{
  "stackName": "HerdrOpenCodeS3FilesystemRuntime",
  "runtimeName": "opencode_s3filesystem_runtime_3",
  "region": "eu-west-1",
  "image": "opencode",
  "inference": {
    "modelId": "global.moonshotai.kimi-k3"
  },
  "lifecycle": {
    "idleRuntimeSessionTimeout": 900,
    "maxLifetime": 28800
  },
  "vpc": {
    "subnetIds": "${SHARED_VPC_SUBNET_IDS}",
    "securityGroupIds": "${SHARED_VPC_SECURITY_GROUP_IDS}"
  },
  "s3Files": {
    "accessPointArn": "${SHARED_S3_FILES_ACCESS_POINT_ARN}",
    "mountPath": "/mnt/workspace",
    "readOnly": false
  }
}
