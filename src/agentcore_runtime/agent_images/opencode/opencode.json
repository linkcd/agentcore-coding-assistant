{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "{env:BEDROCK_INFERENCE_REGION}"
      },
      "models": {
        "global.moonshotai.kimi-k3": {
          "name": "Kimi K3 (global)",
          "provider": { "npm": "@ai-sdk/amazon-bedrock" },
          "limit": { "context": 1000000, "output": 8192 },
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "enabled_providers": ["amazon-bedrock"],
  "plugin": ["file:///app/activity-plugin.mjs"],
  "model": "amazon-bedrock/{env:BEDROCK_MODEL_ID}",
  "small_model": "amazon-bedrock/{env:BEDROCK_MODEL_ID}",
  "autoupdate": false,
  "share": "disabled"
}
