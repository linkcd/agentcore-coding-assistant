# Copy this file to .env beside this file. Git ignores .env.
# The VPC and subnet must already exist in eu-west-1.
# The subnet needs a route to an internet gateway or a NAT gateway.
# Do not add AWS credentials. Use the normal AWS credential chain.
EC2_HOST_VPC_ID=REPLACE_WITH_VPC_ID
EC2_HOST_SUBNET_ID=REPLACE_WITH_SUBNET_ID
